      "rounding": "ceil",
      "update_frequency": "once_per_iteration",
      "update_timing": "after_iteration_is_complete_before_next_iteration_is_started",
      "clipping": "after_rounding",
      "observation_policy": {
        "accepted": "structurally_valid_nonempty_games_with_length_1_to_150",
        "truncated_at_max_length": "include_for_scheduler_and_record_separately",
        "empty_game": "exclude_and_record",
