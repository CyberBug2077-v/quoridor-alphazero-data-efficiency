    "gradient_clip": 1.0,
    "precision": {
      "amp_enabled": true,
      "dtype": "bf16"
    }
  },
  "online_baseline": {
    "seed": 1001,
    "self_play": {
      "iterations": 210,
      "games_per_iteration": 75,
      "mcts_simulations": 200,
      "eval_mcts_in_batch": 10,
      "cpuct": 1.25,
      "temperature_threshold": 15,
      "dirichlet_noise": true,
      "dirichlet_alpha": 0.15,
      "dirichlet_epsilon": 0.25,
      "max_game_length": 150
    },
    "training": {
      "epochs": 4,
      "batch_size": 2048,
      "micro_batch_size": 2048,
      "optimizer": "adamw",
      "learning_rate": 0.0002,
      "weight_decay": 0.0001,
      "gradient_clip": 1.0,
      "precision": {
        "amp_enabled": true,
        "dtype": "bf16"
      }
    },
    "adaptive_scheduler": {
      "method": "target_states",
      "baseline_games": 75,
      "target_states": 2516,
